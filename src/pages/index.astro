							decoding="async"
							fetchpriority="high"
						/>
					</div>
					<div>
						<h1 class="name-lockup__title">
							Kris
						</h1>
						<div class="name-lockup__details">
							<p class="text-2xl font-medium leading-tight sm:text-3xl">Kristoffer Milan</p>
							<p class="text-lg leading-tight text-[#4f4f4f] sm:text-xl">Software Engineer</p>
							<div class="social-links" aria-label="Social links">
								<a href="https://github.com/k-milan" target="_blank" rel="noreferrer" aria-label="GitHub">
									<svg viewBox="0 0 24 24" aria-hidden="true">

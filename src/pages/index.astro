	.contact-form {
		display: grid;
		gap: 0.85rem;
		border: 1.5px solid var(--glass-border);
		border-radius: 1rem;
		padding: 1rem;
		background: var(--glass-bg-strong);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(22px) saturate(150%);

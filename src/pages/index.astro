	.project-panel {
		display: grid;
		grid-template-columns: minmax(18rem, 0.95fr) minmax(0, 1.05fr);
		width: 100%;
		min-height: 23rem;
		overflow: hidden;
		border: 1.5px solid var(--glass-border);
		border-radius: 1rem;
		background: var(--glass-bg);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(22px) saturate(150%);
		-webkit-backdrop-filter: blur(22px) saturate(150%);
		opacity: 0;
		transform: translateX(-4rem);
		transition: opacity 1100ms ease, transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform;
	}

	.project-panel.spotlight-card {
		--spotlight-size: 860px;
		--spotlight-color: rgba(143, 185, 216, 0.14);
		--spotlight-border-width: 2.5px;
		--spotlight-border-strength: 0.95;
	}

	.name-lockup__avatar.spotlight-card {
		--spotlight-size: 430px;
		--spotlight-color: rgba(143, 185, 216, 0.18);
		--spotlight-border-width: 2.5px;
		--spotlight-border-strength: 0.95;
	}

	.project-panel--reverse {
		grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
		transform: translateX(4rem);
	}

	.project-panel.is-visible {
		opacity: 1;
		transform: translateX(0);
	}

	.project-panel--reverse .project-card__image {
		order: 2;
	}

	.project-panel--reverse .project-card__body {
		order: 1;
	}

	.project-card__image {
		display: flex;
		min-height: 100%;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background:
			radial-gradient(circle at 25% 20%, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0) 38%),
			linear-gradient(135deg, rgba(217, 236, 248, 0.68), rgba(143, 185, 216, 0.32));
		border-right: 1px solid rgba(255, 255, 255, 0.46);
		color: rgba(34, 34, 34, 0.38);
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.project-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.project-card__slideshow {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.project-card__slideshow img {
		position: absolute;
		inset: 0;
		opacity: 0;
		animation: project-slideshow 7s ease-in-out infinite;
		animation-delay: calc(var(--slide-index) * 3.5s);
	}

	@keyframes project-slideshow {
		0%, 42% {
			opacity: 1;
		}
		50%, 92% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	.project-panel--reverse .project-card__image {
		border-right: 0;
		border-left: 1px solid rgba(255, 255, 255, 0.46);
	}

	.project-card__body {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding: clamp(1.25rem, 3vw, 2rem);
	}

	.project-panel h3 {
		margin: 0;
		font-size: clamp(2.4rem, 5vw, 4.8rem);
		font-weight: 650;
		line-height: 0.95;
		letter-spacing: 0;
	}

	.project-panel p {
		max-width: 34rem;
		margin: 0.9rem 0 0;
		color: #4f4f4f;
		font-size: clamp(1rem, 1.5vw, 1.2rem);
		line-height: 1.5;
	}

	.project-card__footer {
		display: grid;
		gap: 1rem;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tech-list li {
		display: inline-flex;
		align-items: center;
		border: 1.5px solid rgba(255, 255, 255, 0.78);
		border-radius: 0.8rem;
		padding: 0.52rem;
		background: rgba(255, 255, 255, 0.18);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.48);
		backdrop-filter: blur(12px) saturate(140%);
		-webkit-backdrop-filter: blur(12px) saturate(140%);
		transition: transform 180ms ease, background 180ms ease;
	}

	.tech-list li:hover {
		background: rgba(255, 255, 255, 0.3);
		transform: translateY(-2px) scale(1.04);
	}

	.tech-list img {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 1.45rem;
		object-fit: contain;
	}

	.project-panel a {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		padding: 0.62rem 0.9rem;
		background: #222222;
		color: #faf8f2;
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		transition: background 160ms ease, transform 160ms ease;
	}

	.project-panel a:hover {
		background: #3a3a3a;
		transform: translateY(-1px);
	}

	.technologies-section {
		align-items: stretch;
		justify-content: center;
		padding: 4rem 1rem;
	}

	.technologies-shell {
		display: grid;
		width: min(100%, 76rem);
		align-content: center;
		gap: 2rem;
	}

	.technology-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.technology-tile {
		display: flex;
		width: clamp(4.8rem, 6.4vw, 5.8rem);
		aspect-ratio: 1;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		border: 1.5px solid rgba(255, 255, 255, 0.78);
		border-radius: 1rem;
		padding: clamp(0.7rem, 1.5vw, 1rem);
		background: rgba(255, 255, 255, 0.2);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.52);
		backdrop-filter: blur(12px) saturate(140%);
		-webkit-backdrop-filter: blur(12px) saturate(140%);
		color: #222222;
		opacity: 0;
		transform: translateY(0.9rem) scale(0.92);
		transition:
			width 820ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 520ms ease var(--stagger),
			transform 820ms cubic-bezier(0.16, 1, 0.3, 1) var(--stagger),
			background 420ms ease,
			box-shadow 420ms ease;
	}

	.technology-tile.spotlight-card {
		--spotlight-size: 260px;
		--spotlight-color: rgba(143, 185, 216, 0.18);
	}

	.technology-tile.is-visible {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.technology-grid:hover .technology-tile {
		transition-delay: 0ms;

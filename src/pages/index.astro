			{ name: 'Supabase', icon: 'https://icon.icepanel.io/Technology/svg/Supabase.svg' },
			{ name: 'Firebase', icon: 'https://icon.icepanel.io/Technology/svg/Firebase.svg' },
			{ name: 'AWS', icon: 'https://icon.icepanel.io/Technology/svg/AWS.svg' },
			{ name: 'Azure', icon: 'https://icon.icepanel.io/Technology/svg/Azure.svg' },

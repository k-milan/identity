	.contact-section {
		justify-content: center;
		padding: 4rem 1rem;
		overflow: visible;
	}

	.contact-shell {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1fr);
		width: min(100%, 64rem);
		align-items: center;
		gap: 1rem;
		overflow: visible;
	}

	.contact-copy {
		display: grid;
		gap: 1rem;
	}

	.contact-copy h2 {
		margin: 0;
		font-size: clamp(4rem, 11vw, 8rem);
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: 0;

	.contact-form button {
		width: fit-content;
		border: 0;
		border-radius: 9999px;
		padding: 0.78rem 1rem;
		background: #222222;
		color: #faf8f2;
		font: inherit;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: background 160ms ease, transform 160ms ease;
	}

	.contact-form button:hover {
		background: #3a3a3a;
		transform: translateY(-1px);
	}

	.contact-form button:disabled {
		cursor: wait;
		opacity: 0.62;
		transform: none;
	}

	.contact-toast {
		display: grid;
		position: relative;
		grid-template-columns: 2.8rem 1fr;
		align-items: center;
		gap: 0.8rem;
		max-height: 0;
		border: 1.5px solid rgba(255, 255, 255, 0.8);
		border-radius: 1rem;
		padding: 0 0.8rem;
		background: rgba(255, 255, 255, 0.18);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(16px) saturate(140%);
		-webkit-backdrop-filter: blur(16px) saturate(140%);
		opacity: 0;
		transform: translateY(0.5rem);
		transition: opacity 220ms ease, transform 220ms ease, border-color 220ms ease, max-height 220ms ease, padding 220ms ease;
		pointer-events: none;
		overflow: visible;
	}

	.contact-toast[aria-hidden='false'] {
		max-height: 5rem;
		padding: 0.65rem 0.8rem;
		opacity: 1;
		transform: translateY(0);
	}

	.contact-toast__icon {
		display: grid;
		position: relative;
		z-index: 2;
		width: 2.8rem;
		height: 2.8rem;
		place-items: center;
		border-radius: 9999px;
		background: rgba(217, 236, 248, 0.5);
		color: #5f95bd;
		overflow: visible;
	}

	.contact-toast__icon svg {
		position: relative;
		z-index: 3;
		width: 1.45rem;
		height: 1.45rem;
		fill: currentColor;
		filter: drop-shadow(0 0.35rem 0.7rem rgba(95, 149, 189, 0.32));
		overflow: visible;
		transform-origin: center;
	}

	.contact-toast p {
		margin: 0;
		color: #4f4f4f;
		font-size: 0.92rem;
		font-weight: 650;
		line-height: 1.35;
	}

	.contact-toast[data-state='pending'] .contact-toast__icon svg {
		animation: plane-loop 1.25s ease-in-out infinite;
	}

	.contact-toast[data-state='success'] {
		border-color: rgba(95, 149, 189, 0.42);
	}

	.contact-toast[data-state='success'] .contact-toast__icon svg {
		animation: plane-send 1.1s cubic-bezier(0.2, 0.85, 0.2, 1) forwards;
	}

	.contact-toast[data-state='error'] {
		border-color: rgba(161, 69, 69, 0.34);
	}

	.contact-toast[data-state='error'] .contact-toast__icon {
		background: rgba(161, 69, 69, 0.12);
		color: #a14545;
	}

	@keyframes plane-loop {
		0%, 100% {
			transform: translate(-0.15rem, 0.12rem) rotate(-8deg);
		}
		50% {
			transform: translate(0.35rem, -0.22rem) rotate(10deg);
		}
	}

	@keyframes plane-send {
		0% {
			opacity: 1;
			transform: translate(-0.12rem, 0.1rem) rotate(-8deg) scale(1);
		}
		35% {
			transform: translate(0.45rem, -0.3rem) rotate(12deg) scale(1.06);
		}
		100% {
			opacity: 0;
			transform: translate(5rem, -3rem) rotate(26deg) scale(0.82);
		}
	}

	@media (max-width: 1023px) {
		.technology-tile {
			width: clamp(4.6rem, 18vw, 5.6rem);
		}

		.technology-tile:hover {
			width: clamp(5.4rem, 22vw, 6.6rem);
		}

		.project-panel,
		.project-panel--reverse {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.project-card__image {
			aspect-ratio: 16 / 9;
			min-height: 0;
			border-right: 0;
			border-bottom: 1px solid rgba(255, 255, 255, 0.46);
		}


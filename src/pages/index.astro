									</svg>
								</a>
								<a href="https://www.linkedin.com/in/kristoffer-milan/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M6.94 8.98H3.82v10.24h3.12V8.98ZM5.38 4a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6Zm13.81 9.52c0-3.08-1.64-4.52-3.84-4.52-1.77 0-2.56.98-3 1.66V8.98H9.36v10.24h3.12v-5.07c0-1.34.25-2.64 1.91-2.64 1.64 0 1.66 1.54 1.66 2.73v4.98h3.13v-5.7Z" />
									</svg>
								</a>
								<a href="mailto:kris@miln.dev" aria-label="Email">
									<svg viewBox="0 0 24 24" aria-hidden="true">

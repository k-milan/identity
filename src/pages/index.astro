---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Kris Milan</title>
	</head>
	<body class="min-h-screen overflow-x-hidden bg-[#faf8f2] text-[#222222]">
		<main class="relative isolate">
			<div
				aria-hidden="true"
				class="pointer-events-none fixed left-0 top-0 z-[2] h-[30rem] w-[30rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,_#8fb9d8_0%,_rgba(143,185,216,0.62)_40%,_rgba(143,185,216,0)_76%)] blur-3xl sm:h-[62rem] sm:w-[62rem]"
			>
			</div>
			<div
				aria-hidden="true"
				class="pointer-events-none fixed bottom-0 right-0 z-[2] h-[16rem] w-[16rem] translate-x-1/2 translate-y-1/2 rounded-full bg-[radial-gradient(circle,_#d9ecf8_0%,_rgba(217,236,248,0.82)_36%,_rgba(217,236,248,0)_74%)] blur-3xl sm:h-[46rem] sm:w-[46rem]"
			>
			</div>
			<div aria-hidden="true" class="cursor-glow"></div>
			<div aria-hidden="true" class="background-text" data-pattern="miln.dev"></div>

			<section class="relative z-10 flex min-h-screen flex-col items-center justify-center p-4 pb-8 sm:p-6" data-bg-text="miln.dev">
				<div class="name-lockup">
					<div class="name-lockup__avatar" aria-hidden="true">
						<img src="/smile_kris.png" alt="" class="name-lockup__avatar-image" />
					</div>
					<div>
						<h1 class="name-lockup__title">
							Kris
						</h1>
						<div class="name-lockup__details">
							<p class="text-2xl font-medium leading-tight sm:text-3xl">Kristoffer Milan</p>
							<p class="text-lg leading-tight text-[#4f4f4f] sm:text-xl">Software Engineer</p>
						</div>
					</div>
				</div>
			</section>

			<section class="content-section projects-section" data-bg-text="Projects">
				<div class="projects-shell">
					<div class="section-heading">
						<h2>Projects</h2>
					</div>

					<div class="projects-grid">
						{projects.map((project) => (
							<article class="project-card">
								<div class="project-card__image" aria-label={`${project.title} image placeholder`}>
									<span>{project.title}</span>
								</div>
								<div class="project-card__body">
									<div>
										<h3>{project.title}</h3>
										<p>{project.description}</p>
									</div>
									<div class="project-card__footer">
										<ul class="tech-list" aria-label={`${project.title} technologies`}>
											{project.technologies.map((technology) => (
												<li>
													<img src={technology.icon} alt="" loading="lazy" />
													<span>{technology.name}</span>
												</li>
											))}
										</ul>
										{project.link && <a href={project.link} target="_blank" rel="noreferrer">Open</a>}
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="content-section technologies-section" data-bg-text="Technologies">
				<div class="technologies-shell">
					<div class="section-heading">
						<h2>Technologies</h2>
					</div>

					<div class="technology-groups">
						{technologyGroups.map((group) => (
							<section class="technology-group" aria-labelledby={`${group.name.toLowerCase().replaceAll(' ', '-')}-heading`}>
								<h3 id={`${group.name.toLowerCase().replaceAll(' ', '-')}-heading`}>{group.name}</h3>
								<ul class="technology-list">
									{group.items.map((technology) => (
										<li>
											<img src={technology.icon} alt="" loading="lazy" />
											<span>{technology.name}</span>
										</li>
									))}
								</ul>
							</section>
						))}
					</div>
				</div>
			</section>

			<section class="content-section contact-section" data-bg-text="Contact">
				<div class="contact-shell">
					<div class="contact-copy">
						<h2>Contact</h2>
						<p>
							Got an idea, a role, or something worth building? Send a note and I will get back to you.
						</p>
						<a href="mailto:hello@miln.dev">hello@miln.dev</a>
					</div>

					<form class="contact-form" action="mailto:hello@miln.dev" method="post" enctype="text/plain">
						<label>
							<span>Name</span>
							<input type="text" name="name" autocomplete="name" placeholder="Your name" required />
						</label>
						<label>
							<span>Email</span>
							<input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
						</label>
						<label>
							<span>Message</span>
							<textarea name="message" rows="5" placeholder="Tell me what you have in mind" required></textarea>
						</label>
						<button type="submit">Send email</button>
					</form>
				</div>
			</section>
		</main>
	</body>
</html>

<script>
	const cursorGlow = document.querySelector('.cursor-glow') as HTMLElement | null;
	const backgroundText = document.querySelector('.background-text') as HTMLElement | null;
	const sections = [...document.querySelectorAll<HTMLElement>('[data-bg-text]')];
	let frame = 0;

	const renderBackgroundText = (text: string) => {
		if (!backgroundText || (backgroundText.dataset.pattern === text && backgroundText.childElementCount > 0)) return;

		backgroundText.dataset.pattern = text;
		backgroundText.replaceChildren(
			...Array.from({ length: 180 }, () => {
				const span = document.createElement('span');
				span.textContent = text;
				return span;
			})
		);
	};

	renderBackgroundText(backgroundText?.dataset.pattern ?? 'miln.dev');

	document.addEventListener('pointermove', (event) => {
		if (!cursorGlow || event.pointerType !== 'mouse') return;

		cancelAnimationFrame(frame);
		frame = requestAnimationFrame(() => {
			cursorGlow.style.setProperty('--cursor-x', `${event.clientX}px`);
			cursorGlow.style.setProperty('--cursor-y', `${event.clientY}px`);
			cursorGlow.dataset.active = 'true';
		});
	});

	document.addEventListener('pointerleave', () => {
		if (cursorGlow) cursorGlow.dataset.active = 'false';
	});

	const observer = new IntersectionObserver((entries) => {
		const activeEntry = entries
			.filter((entry) => entry.isIntersecting)
			.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

		const nextPattern = activeEntry?.target.getAttribute('data-bg-text');
		if (nextPattern) renderBackgroundText(nextPattern);
	}, { threshold: [0.45, 0.6, 0.75] });

	sections.forEach((section) => observer.observe(section));
</script>

<style>
	:root {
		--avatar-zoom: 1.5;
	}

	.background-text {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: flex;
		align-content: flex-start;
		flex-wrap: wrap;
		gap: 1.2rem 1.75rem;
		padding: 1.25rem;
		pointer-events: none;
		color: #faf8f2;
		font-size: 1.875rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0;
		opacity: 0.95;
		overflow: hidden;
	}

	.background-text span {
		white-space: nowrap;
	}

	.cursor-glow {
		--cursor-x: 50vw;
		--cursor-y: 50vh;
		position: fixed;
		top: 0;
		left: 0;
		z-index: 0;
		width: 22rem;
		height: 22rem;
		pointer-events: none;
		border-radius: 9999px;
		background: radial-gradient(circle, rgba(217, 236, 248, 0.95) 0%, rgba(217, 236, 248, 0.58) 34%, rgba(217, 236, 248, 0) 72%);
		filter: blur(1.5rem);
		opacity: 0;
		transform: translate(calc(var(--cursor-x) - 50%), calc(var(--cursor-y) - 50%));
		transition: opacity 180ms ease;
	}

	.cursor-glow[data-active='true'] {
		opacity: 1;
	}

	@media (pointer: coarse), (prefers-reduced-motion: reduce) {
		.cursor-glow {
			display: none;
		}
	}

	.name-lockup {
		--name-size: clamp(7rem, 18vw, 14rem);
		--details-height: 4rem;
		--lockup-height: calc((var(--name-size) * 0.86) + var(--details-height));
		display: flex;
		align-items: stretch;
		gap: clamp(0.75rem, 1.8vw, 1.5rem);
		width: max-content;
	}

	.name-lockup__avatar {
		width: var(--lockup-height);
		height: var(--lockup-height);
		flex: 0 0 var(--lockup-height);
		border-radius: 9999px;
		overflow: hidden;
	}

	.name-lockup__avatar-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transform: scale(var(--avatar-zoom));
		transform-origin: center;
	}

	.name-lockup__title {
		margin: 0;
		font-size: var(--name-size);
		font-weight: 600;
		line-height: 0.86;
		letter-spacing: 0;
	}

	.name-lockup__details {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding-left: calc(var(--name-size) * 0.055);
	}

	.content-section {
		position: relative;
		z-index: 10;
		display: flex;
		min-height: 100vh;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.section-heading h2,
	.content-section > h2 {
		margin: 0;
		font-size: clamp(3.5rem, 12vw, 9rem);
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: 0;
	}

	.projects-section {
		align-items: stretch;
		justify-content: center;
		padding: 4rem 1rem;
	}

	.projects-shell {
		display: grid;
		width: min(100%, 76rem);
		align-content: center;
		gap: 2rem;
	}

	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.project-card {
		display: flex;
		min-height: 31rem;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid rgba(34, 34, 34, 0.1);
		border-radius: 1rem;
		background: rgba(250, 248, 242, 0.72);
		box-shadow: 0 1.25rem 3rem rgba(34, 34, 34, 0.07);
		backdrop-filter: blur(16px);
	}

	.project-card__image {
		display: flex;
		aspect-ratio: 4 / 3;
		align-items: center;
		justify-content: center;
		background:
			linear-gradient(135deg, rgba(217, 236, 248, 0.9), rgba(143, 185, 216, 0.52)),
			#d9ecf8;
		color: rgba(34, 34, 34, 0.38);
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.project-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1rem;
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.65rem;
		font-weight: 650;
		line-height: 1;
		letter-spacing: 0;
	}

	.project-card p {
		margin: 0.6rem 0 0;
		color: #4f4f4f;
		font-size: 0.98rem;
		line-height: 1.45;
	}

	.project-card__footer {
		display: grid;
		gap: 1rem;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tech-list li {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid rgba(34, 34, 34, 0.12);
		border-radius: 9999px;
		padding: 0.32rem 0.55rem;
		background: rgba(250, 248, 242, 0.62);
		color: #3f3f3f;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
	}

	.tech-list img {
		width: 1rem;
		height: 1rem;
		flex: 0 0 1rem;
		object-fit: contain;
	}

	.project-card a {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		padding: 0.62rem 0.9rem;
		background: #222222;
		color: #faf8f2;
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		transition: background 160ms ease, transform 160ms ease;
	}

	.project-card a:hover {
		background: #3a3a3a;
		transform: translateY(-1px);
	}

	.technologies-section {
		align-items: stretch;
		justify-content: center;
		padding: 4rem 1rem;
	}

	.technologies-shell {
		display: grid;
		width: min(100%, 76rem);
		align-content: center;
		gap: 2rem;
	}

	.technology-groups {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.technology-group {
		display: grid;
		align-content: start;
		gap: 1rem;
		border: 1px solid rgba(34, 34, 34, 0.1);
		border-radius: 1rem;
		padding: 1rem;
		background: rgba(250, 248, 242, 0.72);
		box-shadow: 0 1.25rem 3rem rgba(34, 34, 34, 0.07);
		backdrop-filter: blur(16px);
	}

	.technology-group h3 {
		margin: 0;
		color: #4f4f4f;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1;
		text-transform: uppercase;
	}

	.technology-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.technology-list li {
		display: flex;
		min-height: 3.5rem;
		align-items: center;
		gap: 0.65rem;
		border: 1px solid rgba(34, 34, 34, 0.1);
		border-radius: 0.8rem;
		padding: 0.65rem;
		background: rgba(250, 248, 242, 0.62);
		color: #222222;
		font-size: 0.94rem;
		font-weight: 650;
		line-height: 1.1;
	}

	.technology-list img {
		width: 1.75rem;
		height: 1.75rem;
		flex: 0 0 1.75rem;
		object-fit: contain;
	}

	.contact-section {
		justify-content: center;
		padding: 4rem 1rem;
	}

	.contact-shell {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1fr);
		width: min(100%, 64rem);
		align-items: center;
		gap: 1rem;
	}

	.contact-copy {
		display: grid;
		gap: 1rem;
	}

	.contact-copy h2 {
		margin: 0;
		font-size: clamp(4rem, 11vw, 8rem);
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: 0;
	}

	.contact-copy p {
		max-width: 24rem;
		margin: 0;
		color: #4f4f4f;
		font-size: 1.05rem;
		line-height: 1.55;
	}

	.contact-copy a {
		width: fit-content;
		color: #222222;
		font-weight: 700;
		text-decoration-color: rgba(34, 34, 34, 0.25);
		text-underline-offset: 0.25rem;
	}

	.contact-form {
		display: grid;
		gap: 0.85rem;
		border: 1px solid rgba(34, 34, 34, 0.1);
		border-radius: 1rem;
		padding: 1rem;
		background: rgba(250, 248, 242, 0.76);
		box-shadow: 0 1.25rem 3rem rgba(34, 34, 34, 0.07);
		backdrop-filter: blur(16px);
	}

	.contact-form label {
		display: grid;
		gap: 0.4rem;
	}

	.contact-form span {
		color: #4f4f4f;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.contact-form input,
	.contact-form textarea {
		width: 100%;
		border: 1px solid rgba(34, 34, 34, 0.12);
		border-radius: 0.8rem;
		padding: 0.85rem 0.9rem;
		background: rgba(250, 248, 242, 0.82);
		color: #222222;
		font: inherit;
		line-height: 1.35;
		outline: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
	}

	.contact-form textarea {
		min-height: 10rem;
		resize: vertical;
	}

	.contact-form input:focus,
	.contact-form textarea:focus {
		border-color: rgba(143, 185, 216, 0.9);
		background: rgba(255, 255, 255, 0.5);
		box-shadow: 0 0 0 4px rgba(217, 236, 248, 0.72);
	}

	.contact-form button {
		width: fit-content;
		border: 0;
		border-radius: 9999px;
		padding: 0.78rem 1rem;
		background: #222222;
		color: #faf8f2;
		font: inherit;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: background 160ms ease, transform 160ms ease;
	}

	.contact-form button:hover {
		background: #3a3a3a;
		transform: translateY(-1px);
	}


	.content-section {
		position: relative;
		z-index: 10;
		display: flex;
		min-height: 100vh;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.section-heading h2,
	.content-section > h2 {
		margin: 0;
		font-size: clamp(3.5rem, 12vw, 9rem);
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: 0;
	}

	.projects-section {
		align-items: stretch;
		justify-content: center;
		padding: 4rem 1rem;
	}

	.projects-shell {
		display: grid;
		width: min(100%, 76rem);
		align-content: center;
		gap: 2rem;
	}

	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
	}

	.glass-text {
		color: rgba(217, 236, 248, 0.26);
		text-shadow:
			0 1px 0 rgba(255, 255, 255, 0.64),
			0 0 1.2rem rgba(143, 185, 216, 0.22),
			0 1rem 2.4rem rgba(34, 34, 34, 0.08);
		-webkit-text-stroke: 1.15px rgba(143, 185, 216, 0.5);
	}

	.projects-list {
		display: grid;
		gap: 1.25rem;

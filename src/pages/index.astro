</html>

<script>
	const cursorGlow = document.querySelector('.cursor-glow') as HTMLElement | null;
	const backgroundText = document.querySelector('.background-text') as HTMLElement | null;
	const sections = [...document.querySelectorAll<HTMLElement>('[data-bg-text]')];
	const revealItems = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
	const technologyTiles = [...document.querySelectorAll<HTMLElement>('.technology-tile')];
	const spotlightCards = [...document.querySelectorAll<HTMLElement>('.spotlight-card')];
	const contactForm = document.querySelector('#contact-form') as HTMLFormElement | null;
	const contactResult = document.querySelector('#contact-result') as HTMLElement | null;
	const contactResultText = contactResult?.querySelector('p') ?? null;
	let frame = 0;
	let spotlightFrame = 0;
	let lastScrollY = window.scrollY;
	let scrollDirection: 'up' | 'down' = 'down';

	const getBackgroundTextCount = (text: string) => {
		const estimatedTileWidth = Math.max(text.length * 24 + 28, 110);
		const estimatedTileHeight = 50;
		const viewportArea = window.innerWidth * window.innerHeight;
		const tileArea = estimatedTileWidth * estimatedTileHeight;

		return Math.ceil(viewportArea / tileArea * 2.4);
	};

	const renderBackgroundText = (text: string, force = false) => {
		if (!backgroundText) return;

		const textCount = getBackgroundTextCount(text);
		if (!force && backgroundText.dataset.pattern === text && backgroundText.childElementCount >= textCount) return;

		backgroundText.dataset.pattern = text;
		backgroundText.replaceChildren(
			...Array.from({ length: textCount }, () => {
				const span = document.createElement('span');
				span.textContent = text;
				return span;
			})
		);
	};

	renderBackgroundText(backgroundText?.dataset.pattern ?? 'miln.dev');

	window.addEventListener('resize', () => {
		renderBackgroundText(backgroundText?.dataset.pattern ?? 'miln.dev', true);
	});

	document.addEventListener('pointermove', (event) => {
		if (!cursorGlow || event.pointerType !== 'mouse') return;

		cancelAnimationFrame(frame);
		frame = requestAnimationFrame(() => {
			cursorGlow.style.setProperty('--cursor-x', `${event.clientX}px`);
			cursorGlow.style.setProperty('--cursor-y', `${event.clientY}px`);
			cursorGlow.dataset.active = 'true';
		});
	});

	document.addEventListener('pointerleave', () => {
		if (cursorGlow) cursorGlow.dataset.active = 'false';
	});

	document.addEventListener('scroll', () => {
		const currentScrollY = window.scrollY;
		scrollDirection = currentScrollY < lastScrollY ? 'up' : 'down';
		lastScrollY = currentScrollY;
	}, { passive: true });

	const updateActiveBackgroundText = () => {
		const viewportCenter = window.innerHeight / 2;
		const activeSection = sections
			.map((section) => {
				const rect = section.getBoundingClientRect();
				const sectionCenter = rect.top + rect.height / 2;
				return {
					section,
					distance: Math.abs(sectionCenter - viewportCenter),
				};
			})
			.sort((a, b) => a.distance - b.distance)[0]?.section;

		const nextPattern = activeSection?.getAttribute('data-bg-text');
		if (nextPattern) renderBackgroundText(nextPattern);
	};

	const observer = new IntersectionObserver(() => {
		updateActiveBackgroundText();
	}, { threshold: [0, 0.25, 0.5, 0.75, 1] });

	sections.forEach((section) => observer.observe(section));
	document.addEventListener('scroll', updateActiveBackgroundText, { passive: true });

	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				return;
			}

			if (scrollDirection === 'up') {
				entry.target.classList.remove('is-visible');
			}
		});
	}, { threshold: 0.42, rootMargin: '0px 0px -24% 0px' });

	revealItems.forEach((item) => revealObserver.observe(item));

	const updateSpotlights = (event: PointerEvent) => {
		if (event.pointerType !== 'mouse') return;

		cancelAnimationFrame(spotlightFrame);
		spotlightFrame = requestAnimationFrame(() => {
			spotlightCards.forEach((card) => {
			const rect = card.getBoundingClientRect();
				const nearestX = Math.max(rect.left, Math.min(event.clientX, rect.right));
				const nearestY = Math.max(rect.top, Math.min(event.clientY, rect.bottom));
				const distance = Math.hypot(event.clientX - nearestX, event.clientY - nearestY);
				const influence = Math.max(rect.width, rect.height, 280) * 0.85;

			card.style.setProperty('--spotlight-x', `${event.clientX - rect.left}px`);
			card.style.setProperty('--spotlight-y', `${event.clientY - rect.top}px`);
				card.classList.toggle('is-spotlight-active', distance <= influence);
			});
		});
	};

	document.addEventListener('pointermove', updateSpotlights);
	document.addEventListener('pointerleave', () => {
		spotlightCards.forEach((card) => card.classList.remove('is-spotlight-active'));
	});

	const technologyObserver = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				return;
			}

			if (scrollDirection === 'up') {
				entry.target.classList.remove('is-visible');
			}
		});
	}, { threshold: 0.2, rootMargin: '0px 0px -12% 0px' });

	technologyTiles.forEach((tile) => technologyObserver.observe(tile));

	contactForm?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!contactForm.checkValidity()) {
			contactForm.reportValidity();
			return;
		}

		const submitButton = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
		const formData = new FormData(contactForm);
		const payload = JSON.stringify(Object.fromEntries(formData));

		if (contactResult && contactResultText) {
			contactResult.dataset.state = 'pending';
			contactResult.setAttribute('aria-hidden', 'false');
			contactResultText.textContent = 'Sending your message...';
		}

		if (submitButton) submitButton.disabled = true;

		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					Accept: 'application/json',
				},
				body: payload,
			});
			const result = await response.json();

			if (!response.ok || !result.success) {
				throw new Error(result.message ?? 'Unable to send message.');
			}

			contactForm.reset();
			if (contactResult && contactResultText) {
				contactResult.dataset.state = 'success';
				contactResultText.textContent = 'Message sent. I will get back to you soon.';
			}
		} catch (error) {
			if (contactResult && contactResultText) {
				contactResult.dataset.state = 'error';
				contactResult.setAttribute('aria-hidden', 'false');
				contactResultText.textContent = error instanceof Error ? error.message : 'Something went wrong.';
			}
		} finally {
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>

<style>
	:root {
		--avatar-zoom: 1.5;
		--glass-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(250, 248, 242, 0.12));
		--glass-bg-strong: linear-gradient(135deg, rgba(255, 255, 255, 0.42), rgba(250, 248, 242, 0.16));
		--glass-border: rgba(255, 255, 255, 0.82);
		--glass-border-muted: rgba(34, 34, 34, 0.12);
		--glass-shadow: 0 1.25rem 3.5rem rgba(34, 34, 34, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.62);
	}

	.background-text {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: flex;
		align-content: flex-start;
		flex-wrap: wrap;
		gap: 1.2rem 1.75rem;
		padding: 1.25rem;
		pointer-events: none;
		color: #faf8f2;
		font-size: 1.875rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0;
		opacity: 0.95;
		overflow: visible;
	}

	.background-text span {
		white-space: nowrap;
	}

	.cursor-glow {
		--cursor-x: 50vw;
		--cursor-y: 50vh;
		position: fixed;
		top: 0;
		left: 0;
		z-index: 0;
		width: 22rem;
		height: 22rem;
		pointer-events: none;
		border-radius: 9999px;
		background: radial-gradient(circle, rgba(217, 236, 248, 0.95) 0%, rgba(217, 236, 248, 0.58) 34%, rgba(217, 236, 248, 0) 72%);
		filter: blur(1.5rem);
		opacity: 0;
		transform: translate(calc(var(--cursor-x) - 50%), calc(var(--cursor-y) - 50%));
		transition: opacity 180ms ease;
	}

	.cursor-glow[data-active='true'] {
		opacity: 1;
	}

	.spotlight-card {
		--spotlight-size: 520px;
		--spotlight-color: rgba(143, 185, 216, 0.16);
		--spotlight-border-width: 2px;
		--spotlight-border-strength: 0.76;
		position: relative;
		border-color: transparent !important;
	}

	.spotlight-card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
		background: radial-gradient(
			circle var(--spotlight-size) at var(--spotlight-x, -999px) var(--spotlight-y, -999px),
			var(--spotlight-color),
			rgba(217, 236, 248, 0.06) 38%,
			transparent 84%
		);
		opacity: 0;
		pointer-events: none;
		transition: opacity 220ms ease;
	}

	.spotlight-card:hover::before,
	.spotlight-card.is-spotlight-active::before {
		opacity: 1;
	}

	.spotlight-card > :not(.spotlight-border) {
		position: relative;
		z-index: 1;
	}

	.spotlight-border {
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
		padding: var(--spotlight-border-width);
		background: radial-gradient(
			circle var(--spotlight-size) at var(--spotlight-x, -999px) var(--spotlight-y, -999px),
			rgba(95, 149, 189, var(--spotlight-border-strength)),
			rgba(143, 185, 216, calc(var(--spotlight-border-strength) * 0.46)) 36%,
			transparent 78%
		);
		opacity: 0;
		pointer-events: none;
		transition: opacity 220ms ease;
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
	}

	.spotlight-card:hover > .spotlight-border,
	.spotlight-card.is-spotlight-active > .spotlight-border {
		opacity: 1;
	}

	@media (pointer: coarse), (prefers-reduced-motion: reduce) {
		.cursor-glow {
			display: none;
		}
	}

	.name-lockup {
		--name-size: clamp(7rem, 18vw, 14rem);
		--details-height: 4rem;
		--lockup-height: calc((var(--name-size) * 0.86) + var(--details-height));
		display: flex;
		align-items: stretch;
		gap: clamp(0.75rem, 1.8vw, 1.5rem);

							<article class:list={['project-panel spotlight-card', { 'project-panel--reverse': index % 2 === 1 }]} data-reveal={index % 2 === 0 ? 'left' : 'right'}>
								<span class="spotlight-border" aria-hidden="true"></span>
								<div class="project-card__image" aria-label={`${project.title} image placeholder`}>
									{project.images ? (
										<div class="project-card__slideshow">
											{project.images.map((image, imageIndex) => (
												<img
													src={image}
													alt={`${project.title} preview ${imageIndex + 1}`}
													loading="lazy"
													decoding="async"
													sizes="(max-width: 1023px) calc(100vw - 2rem), 38rem"
													style={`--slide-index: ${imageIndex};`}
												/>
											))}
										</div>
									) : project.image ? (
										<img
											src={project.image}
											alt={`${project.title} preview`}
											loading="lazy"
											decoding="async"
											sizes="(max-width: 1023px) calc(100vw - 2rem), 38rem"
										/>
									) : (
										<span>{project.title}</span>
									)}
								</div>
								<div class="project-card__body">
									<div>
										<h3>{project.title}</h3>
										<p>{project.description}</p>
									</div>
									<div class="project-card__footer">
										<ul class="tech-list" aria-label={`${project.title} technologies`}>
											{project.technologies.map((technology) => (
												<li>
													<img src={technology.icon} alt={technology.name} title={technology.name} loading="lazy" decoding="async" />
												</li>
											))}
										</ul>
										{project.link && <a href={project.link} target="_blank" rel="noreferrer">Open</a>}
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="content-section technologies-section" data-bg-text="Technologies">
				<div class="technologies-shell">
					<div class="section-heading">
						<h2 class="glass-text">Technologies</h2>
					</div>

					<ul class="technology-grid" aria-label="Technologies">
						{technologies.map((technology, index) => (
							<li class="technology-tile spotlight-card" style={`--stagger: ${index * 55}ms;`} title={technology.name}>
								<span class="spotlight-border" aria-hidden="true"></span>
								<img src={technology.icon} alt={technology.name} loading="lazy" decoding="async" />
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="content-section contact-section" data-bg-text="Contact">
				<div class="contact-shell">
					<div class="contact-copy">
						<h2 class="glass-text">Contact</h2>
						<p>
							Got an idea, a role, or something worth building? Send a note and I will get back to you.
						</p>
						<a href="mailto:kris@miln.dev">kris@miln.dev</a>
					</div>

					<form class="contact-form spotlight-card" action="https://api.web3forms.com/submit" method="POST" id="contact-form">
						<span class="spotlight-border" aria-hidden="true"></span>
						<input type="hidden" name="access_key" value={web3formsAccessKey} />
						<input type="hidden" name="subject" value="New portfolio message from miln.dev" />
						<input type="hidden" name="from_name" value="miln.dev" />
						<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
						<label>
							<span>Name</span>
							<input type="text" name="name" autocomplete="name" placeholder="Your name" required />
						</label>
						<label>
							<span>Email</span>
							<input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
						</label>
						<label>
							<span>Message</span>
							<textarea name="message" rows="5" placeholder="Tell me what you have in mind" required></textarea>
						</label>
						<button type="submit">Send email</button>
						<div class="contact-toast" id="contact-result" role="status" aria-live="polite" aria-hidden="true">
							<div class="contact-toast__icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="M21.58 3.49a1 1 0 0 0-1.08-.16L3.12 11.08a1 1 0 0 0 .06 1.86l6.7 2.42 2.42 6.7a1 1 0 0 0 .9.66h.04a1 1 0 0 0 .9-.58l7.75-17.38a1 1 0 0 0-.31-1.27ZM13.35 18.9l-1.58-4.39 4.54-4.54a.75.75 0 0 0-1.06-1.06l-4.54 4.54-4.39-1.58L19.1 6.13 13.35 18.9Z" />
								</svg>
							</div>
							<p></p>
						</div>
					</form>
				</div>
			</section>
		</main>

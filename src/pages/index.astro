		name: 'Frontend',
		items: [
			{ name: 'Flutter', icon: 'https://icon.icepanel.io/Technology/svg/Flutter.svg' },
			{ name: 'React', icon: 'https://icon.icepanel.io/Technology/svg/React.svg' },
			{ name: 'Next.js', icon: 'https://icon.icepanel.io/Technology/svg/Next.js.svg' },
			{ name: 'Vue', icon: 'https://icon.icepanel.io/Technology/svg/Vue.js.svg' },
			{ name: 'Nuxt.js', icon: 'https://icon.icepanel.io/Technology/svg/Nuxt-JS.svg' },
			{ name: 'Astro', icon: 'https://icon.icepanel.io/Technology/svg/Astro.svg' },
		],

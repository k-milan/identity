	.technology-tile:hover {
		width: clamp(5.8rem, 7.8vw, 7rem);
		background: rgba(255, 255, 255, 0.32);
		box-shadow:
			0 1.5rem 3rem rgba(34, 34, 34, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.62);
		transform: translateY(-0.18rem) scale(1.03);
	}

	.technology-tile img {
		width: min(3rem, 58%);
		height: min(3rem, 58%);
		flex: 0 0 auto;
		object-fit: contain;
		transition: transform 820ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.technology-tile:hover img {
